{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "levels-fyi": {
      "type": "streamable-http",
      "url": "https://mcp.levels.fyi/?client=openai-plugin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://mcp.levels.fyi/register",
            "baseScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
}
