{
  "tools": [
    {
      "name": "send-feedback",
      "description": "Report a wrong, doubtful or missing figure, or something the tools can't do, to the Levels.fyi team. Offer it when the user doubts a figure or a tool finds nothing they asked about. Send it after the user agrees, or when they asked for the report. No personal details; contactEmail only when the user wants a reply and gives it. Returns { received, id }.",
      "annotations": {
        "title": "Send Feedback",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "wrong_data",
              "missing_data",
              "missing_feature",
              "other"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          },
          "toolName": {
            "type": "string"
          },
          "companySlug": {
            "type": "string"
          },
          "jobFamilySlug": {
            "type": "string"
          },
          "locationSlug": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  ]
}
